<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.medset.medsetai.controller.JuegoController"
            stylesheets="@../css/app.css"
            prefHeight="750.0"
            prefWidth="1200.0">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="dashboard-top-bar">
            <Button text="← Inicio" onAction="#volverAlInicio" styleClass="secondary-button"/>
            <Label text="Módulo 3 · Juego: Detective de síntomas" styleClass="dashboard-app-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="puntosLabel" styleClass="score"/>
            <Label fx:id="totalLabel" styleClass="dashboard-status-label"/>
        </HBox>
    </top>

    <left>
        <ScrollPane fitToWidth="true" prefWidth="380" styleClass="plain-scroll">
            <VBox spacing="10" styleClass="lab-left">
                <Label fx:id="candidatosTitulo" styleClass="section-title"/>
                <Label text="C empieza siendo todo el catálogo D. Cuando creas saberlo, tocá «¡Es esta!» (un error cuesta 25 puntos)."
                       wrapText="true" styleClass="panel-description"/>
                <VBox fx:id="candidatosBox" spacing="8"/>
            </VBox>
        </ScrollPane>
    </left>

    <center>
        <ScrollPane fitToWidth="true" styleClass="plain-scroll">
            <VBox spacing="14" styleClass="dashboard-content">
                <Label text="El sistema eligió una enfermedad secreta X. Descubrila preguntando por síntomas."
                       wrapText="true" styleClass="section-title"/>
                <Label text="Cada pregunta es una prueba de pertenencia «¿s ∈ X?» y cuesta 10 puntos. Elegí síntomas que dividan bien a los candidatos."
                       wrapText="true" styleClass="panel-description"/>
                <FlowPane fx:id="preguntasPane" hgap="8" vgap="8"/>
                <HBox spacing="10">
                    <Button fx:id="pistaButton" text="💡 Pista (pregunta óptima)" onAction="#pista" styleClass="small-button"/>
                    <Button fx:id="rendirseButton" text="Rendirse" onAction="#rendirse" styleClass="small-button"/>
                    <Button text="Nueva ronda" onAction="#nuevaRonda" styleClass="primary-button"/>
                </HBox>
                <Label fx:id="mensajeLabel" wrapText="true" styleClass="game-message"/>
                <Label text="Razonamiento con conjuntos" styleClass="field-label"/>
                <VBox fx:id="registroBox" spacing="6" styleClass="log-box"/>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
