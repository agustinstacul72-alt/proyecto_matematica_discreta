<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.medset.medsetai.controller.CreditsController"
           stylesheets="@../css/app.css"
           styleClass="credits-root">

    <VBox alignment="CENTER"
          spacing="10"
          maxWidth="720"
          styleClass="credits-container">

        <!-- Logo -->
        <ImageView fitWidth="300"
                   fitHeight="300"
                   preserveRatio="true"
                   styleClass="credits-logo">
            <image>
                <Image url="@../images/jala-logo.png"/>
            </image>
        </ImageView>

        <Label text="Matemáticas Discretas"
               styleClass="credits-course"/>

        <HBox alignment="CENTER"
              spacing="8"
              styleClass="credits-group">

            <Label text="Grupo"
                   styleClass="credits-label"/>

            <Label text="6"
                   styleClass="credits-group-number"/>

        </HBox>

        <!-- Professor -->
        <VBox alignment="CENTER"
              spacing="3"
              styleClass="credits-section">

            <Label text="PROFESOR"
                   styleClass="credits-heading"/>

            <Label text="Rafael Pastor Martínez Vargas"
                   styleClass="credits-professor"/>

        </VBox>

        <!-- Students -->
        <VBox alignment="CENTER"
              spacing="5"
              styleClass="credits-section">

            <Label text="ALUMNOS"
                   styleClass="credits-heading"/>

            <Label text="Daniel Tueros Cueva"
                   styleClass="credits-student"/>

            <Label text="Brisa Abigail Alvarez"
                   styleClass="credits-student"/>

            <Label text="Stacul Dario Agustin"
                   styleClass="credits-student"/>

            <Label text="Dayana Lucia Posada Narváez"
                   styleClass="credits-student"/>

            <Label text="Agustin Tomas Gammuto"
                   styleClass="credits-student"/>

            <Label text="Jose David Carranza Angarita"
                   styleClass="credits-student"/>

        </VBox>

        <!-- Close -->
        <Button text="Volver"
                onAction="#handleClose"
                styleClass="secondary-button"/>

    </VBox>

</StackPane>