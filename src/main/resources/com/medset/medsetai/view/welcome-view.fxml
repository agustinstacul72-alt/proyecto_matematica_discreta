<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.medset.medsetai.controller.WelcomeController"
           stylesheets="@../css/app.css"
           styleClass="welcome-root">

    <VBox alignment="CENTER"
          spacing="22"
          maxWidth="700"
          styleClass="welcome-container">

        <ImageView fitWidth="300"
                   fitHeight="300"
                   preserveRatio="true">

            <image>
                <Image url="@../images/jala-logo.png"/>
            </image>

        </ImageView>

        <Label text="Calculadora de Conjuntos Numericos"
               wrapText="true"
               maxWidth="600"
               textAlignment="CENTER"
               alignment="CENTER"
               styleClass="welcome-subtitle"/>

        <HBox alignment="CENTER"
              spacing="15">

            <Button text="Calculadora"
                    onAction="#handleStart"
                    styleClass="primary-button"/>

            <Button text="Integrantes"
                    onAction="#handleCredits"
                    styleClass="secondary-button"/>

        </HBox>

    </VBox>

</StackPane>