<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.medset.medsetai.controller.WelcomeController"
           stylesheets="@../css/app.css"
           styleClass="welcome-root">

    <VBox alignment="CENTER"
          spacing="22"
          maxWidth="700"
          styleClass="welcome-container">

        <ImageView fitWidth="150"
                   fitHeight="150"
                   preserveRatio="true">

            <image>
                <Image url="@../images/medset-logo.png"/>
            </image>

        </ImageView>

        <Label text="MedSet AI"
               styleClass="welcome-title"/>

        <Label text="An educational platform for symptom analysis using set theory and artificial intelligence."
               wrapText="true"
               maxWidth="600"
               styleClass="welcome-subtitle"/>

        <Label text="Learn • Analyze • Understand"
               styleClass="welcome-tagline"/>

        <HBox alignment="CENTER"
              spacing="15">

            <Button text="Get Started"
                    onAction="#handleStart"
                    styleClass="primary-button"/>

            <Button text="About the Project"
                    onAction="#handleCredits"
                    styleClass="secondary-button"/>

        </HBox>

        <Label text="Educational simulator • Not a medical diagnostic tool"
               styleClass="welcome-disclaimer"/>

        <!-- Jala University -->

        <ImageView fitWidth="133"
                   fitHeight="63"
                   preserveRatio="true"
                   opacity="0.85"
                   styleClass="jala-logo">

            <image>
                <Image url="@../images/jala-logo.png"/>
            </image>

        </ImageView>

    </VBox>

</StackPane>