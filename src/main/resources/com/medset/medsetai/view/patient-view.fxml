<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<!--
    Patient management screen for MedSet AI.

    The controller handles patient CRUD operations and publishes selected
    patients to the analysis module. Set operations and report generation
    are intentionally handled by separate analysis components.
-->
<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.medset.medsetai.controller.PatientController"
        stylesheets="@../css/app.css">

    <top>
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="dashboard-top-bar">
            <padding>
                <Insets top="16" right="24" bottom="16" left="24"/>
            </padding>

            <Button
                    text="← Dashboard"
                    onAction="#handleBackToDashboard"
                    styleClass="secondary-button"/>

            <Label text="MedSet AI" styleClass="section-title"/>

            <Label
                    text="Patient Management"
                    styleClass="panel-description"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="24" styleClass="dashboard-content">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <!-- Saved patient list -->
            <VBox spacing="12" prefWidth="420">
                <Label text="Saved Patients" styleClass="panel-title"/>

                <Label
                        text="Select one patient to edit, or multiple patients for analysis."
                        styleClass="panel-description"
                        wrapText="true"/>

                <ListView
                        fx:id="patientListView"
                        VBox.vgrow="ALWAYS"/>

                <HBox spacing="10">
                    <Button
                            text="+ New Patient"
                            onAction="#handleNewPatient"
                            styleClass="secondary-button"/>

                    <Button
                            text="Delete Selected"
                            onAction="#handleDeleteSelected"
                            styleClass="secondary-button"/>
                </HBox>
            </VBox>

            <!-- Patient form -->
            <VBox
                    spacing="14"
                    HBox.hgrow="ALWAYS"
                    styleClass="patient-form">

                <Label text="Patient Information" styleClass="panel-title"/>

                <Label
                        text="Enter simulated patient information and symptom descriptions."
                        styleClass="panel-description"
                        wrapText="true"/>

                <GridPane hgap="12" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints minWidth="100"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label
                            text="Name"
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="0"
                            styleClass="field-label"/>

                    <TextField
                            fx:id="patientNameField"
                            promptText="Enter patient's name"
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="1"
                            styleClass="form-input"/>

                    <Label
                            text="Age"
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="0"
                            styleClass="field-label"/>

                    <TextField
                            fx:id="patientAgeField"
                            promptText="Age in years"
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="1"
                            styleClass="form-input"/>
                </GridPane>

                <Label
                        text="Symptoms"
                        styleClass="field-label"/>

                <TextArea
                        fx:id="symptomsArea"
                        promptText="Example: fiebre, tos y dolor de garganta"
                        wrapText="true"
                        prefRowCount="8"
                        VBox.vgrow="ALWAYS"
                        styleClass="symptoms-area"/>

                <Label
                        text="Ollama normalizes symptom labels for set-theory exercises. This app does not provide medical diagnoses."
                        styleClass="panel-description"
                        wrapText="true"/>

                <Button
                        fx:id="savePatientButton"
                        text="Save Patient"
                        onAction="#handleSavePatient"
                        maxWidth="Infinity"
                        styleClass="primary-button"/>

                <Button
                        fx:id="prepareAnalysisButton"
                        text="Prepare Analysis"
                        onAction="#handleAnalyzeSelected"
                        maxWidth="Infinity"
                        styleClass="secondary-button"/>

                <Button
                        text="View Report"
                        onAction="#handleShowReport"
                        maxWidth="Infinity"
                        styleClass="secondary-button"/>

                <Button
                        text="View Graph"
                        onAction="#handleShowGraph"
                        maxWidth="Infinity"
                        styleClass="secondary-button"/>

                <Label
                        fx:id="statusLabel"
                        text="Ready."
                        wrapText="true"
                        styleClass="panel-description"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>