<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.medset.medsetai.controller.DashboardController"
            stylesheets="@../css/app.css"
            prefHeight="750.0"
            prefWidth="1200.0">

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              styleClass="dashboard-top-bar">

            <Button text="← Volver"
                    onAction="#handleBackToWelcome"
                    styleClass="secondary-button"/>

            <Region HBox.hgrow="ALWAYS"/>

        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <VBox fx:id="calculatorPanel"
              spacing="20"
              alignment="CENTER"
              styleClass="dashboard-content">

            <Label text="Calculadora de conjuntos" styleClass="panel-title"/>

            <StackPane VBox.vgrow="ALWAYS" alignment="CENTER">

                <VBox fx:id="selectorPanel" spacing="20" alignment="CENTER">

                    <Label text="Elegí una operación" styleClass="section-title"/>

                    <HBox spacing="20" alignment="CENTER">

                        <Button onAction="#elegirUnion" styleClass="op-card">
                            <graphic>
                                <VBox alignment="CENTER" spacing="6">
                                    <Label text="∪" styleClass="op-symbol"/>
                                    <Label text="Unión" styleClass="op-name"/>
                                </VBox>
                            </graphic>
                        </Button>

                        <Button onAction="#elegirInterseccion" styleClass="op-card">
                            <graphic>
                                <VBox alignment="CENTER" spacing="6">
                                    <Label text="∩" styleClass="op-symbol"/>
                                    <Label text="Intersección" styleClass="op-name"/>
                                </VBox>
                            </graphic>
                        </Button>

                        <Button onAction="#elegirDiferencia" styleClass="op-card">
                            <graphic>
                                <VBox alignment="CENTER" spacing="6">
                                    <Label text="-" styleClass="op-symbol"/>
                                    <Label text="Diferencia" styleClass="op-name"/>
                                </VBox>
                            </graphic>
                        </Button>

                        <Button onAction="#elegirSimetrica" styleClass="op-card">
                            <graphic>
                                <VBox alignment="CENTER" spacing="6">
                                    <Label text="Δ" styleClass="op-symbol"/>
                                    <Label text="Dif. Simétrica" styleClass="op-name"/>
                                </VBox>
                            </graphic>
                        </Button>

                    </HBox>
                </VBox>

                <!-- ===== PANTALLA 2: INGRESAR CONJUNTOS ===== -->
                <VBox fx:id="inputPanel" spacing="14"
                      alignment="TOP_CENTER"
                      maxWidth="480"
                      maxHeight="-Infinity"
                      visible="false"
                      managed="false"
                      styleClass="patient-form">

                    <HBox alignment="CENTER_LEFT">
                        <Button text="← Cambiar operación" onAction="#volverAlSelector"
                                styleClass="secondary-button"/>
                    </HBox>

                    <Label fx:id="operacionLabel" styleClass="section-title"/>

                    <Label text="Conjunto A" styleClass="field-label"/>
                    <TextField fx:id="conjuntoAField" promptText="Ej: 1, 2, 3" styleClass="form-input"/>

                    <Label text="Conjunto B" styleClass="field-label"/>
                    <TextField fx:id="conjuntoBField" promptText="Ej: 3, 4, 5" styleClass="form-input"/>

                    <Button text="Calcular" onAction="#handleCalcular" styleClass="primary-button"/>

                    <Label fx:id="resultadoLabel" wrapText="true" styleClass="result-text"/>

                </VBox>

            </StackPane>

        </VBox>

    </center>

</BorderPane>